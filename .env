BASE_URL=https://automationteststore.com/
API_BASE_URL=https://jsonplaceholder.typicode.com/
AUTH_API=https://dummyjson.com/auth/
APP_USERNAME=test-automation
APP_PASSWORD=Test@123
HEADLESS=false
BROWSER=chromium
SLOW_MO=0
TIMEOUT=70000
RETRIES=1
WORKERS=4

# CRM environment. Local runs use the values below (staging, on Render since 2026-10-28).
# CI picks staging or production with TARGET_ENV; its environment-scoped variables win there.
TARGET_ENV=staging
NEWAPP_BASE_URL=https://automation-crm-7qil.onrender.com
NEWAPP_EMAIL=admin@crm.com
NEWAPP_PASSWORD=Pass@123
NEWAPP_BASE_API=https://crm-practice-api.onrender.com
# Production (CI: TARGET_ENV=production uses the GitLab production-scoped variables):
#   NEWAPP_BASE_URL=https://automation-crm-prod.onrender.com
#   NEWAPP_BASE_API=https://crm-practice-api-prod.onrender.com

AI_HEALING_ENABLED=true
AI_HEALING_PROVIDER_ORDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_HEALING_TIMEOUT_MS=5000
AI_HEALING_LLM_TIMEOUT_MS=10000
AI_HEALING_MAX_ATTEMPTS=1
AI_HEALING_MAX_EXPLORE_ROUNDS=6
AI_HEALING_CACHE=true
