# -------------------------------------------------------------
# .env.example - Safe template for environment configuration.
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file - it is gitignored.
# -------------------------------------------------------------

BASE_URL=https://your-app-url.com/
API_BASE_URL=https://your-app-url.com/api
AUTH_API=https://your-app-url.com/auth
APP_USERNAME=your-username
APP_PASSWORD=your-password

HEADLESS=false
BROWSER=chromium
SLOW_MO=0
TIMEOUT=30000
RETRIES=1
WORKERS=2

# -------------------------------------------------------------
# New Application (SCAFFOLD) - rename NEWAPP_* once the real
# app name is known. Leave blank/fill in once the URL is ready.
# NEWAPP_EMAIL is the Admin account. global-setup.ts signs in once per
# role (Admin, Rep, Viewer) and saves auth/storageState.<role>.json
# (gitignored). Rep and Viewer use NEWAPP_PASSWORD and default to the
# CRM README's rep@crm.com / viewer@crm.com unless overridden below.
# -------------------------------------------------------------
NEWAPP_BASE_URL=
NEWAPP_BASE_API=
NEWAPP_EMAIL=
NEWAPP_PASSWORD=
NEWAPP_REP_EMAIL=
NEWAPP_VIEWER_EMAIL=

# -------------------------------------------------------------
# AI self-healing locators - off by default. Set AI_HEALING_ENABLED=true
# and provide GROQ_API_KEY to enable.
# Groq key: https://console.groq.com/keys (free)
# -------------------------------------------------------------
AI_HEALING_ENABLED=false
AI_HEALING_PROVIDER_ORDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_HEALING_TIMEOUT_MS=5000
AI_HEALING_LLM_TIMEOUT_MS=10000
AI_HEALING_MAX_ATTEMPTS=1
AI_HEALING_MAX_EXPLORE_ROUNDS=6
AI_HEALING_CACHE=true
